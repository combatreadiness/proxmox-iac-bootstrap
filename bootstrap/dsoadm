#!/usr/bin/env bash
# =============================================================
# dsoadm — host-side CLI for proxmox-iac-bootstrap
# Runs on the Proxmox host as root. Every command works on one
# environment (--env NAME, default "lab").
# =============================================================
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=bootstrap/lib.sh
. "${DIR}/lib.sh"

INSTALLED_LIB=/usr/local/lib/proxmox-iac-bootstrap
BIN_LINK=/usr/local/sbin/dsoadm

usage() {
  cat <<'USAGE'
dsoadm — Proxmox IaC bootstrap (host side)

Usage:  dsoadm <command> [--env NAME] [options]      (NAME defaults to "lab")

  init     [--rotate-token] [--acl-root]   Network, API account, pools, management node
  template                                 Cloud-init VM template for OpenTofu to clone (optional)
  facts                                    Tell the management node about this host
  reset    [--dry-run] [--sdn] [--purge] [-y]
                                           Remove what this environment created
  list                                     All environments and their management node
  config                                   Settings this environment will use (file + defaults)
  uninstall [--dry-run] [--keep-config] [--all] [-y]
                                           reset --purge --sdn, then forget the environment;
                                           the tool itself goes with the last environment
  version                                  Installed version

Options:
  --env NAME       Environment: 1-6 lowercase letters/digits, starting with a letter
  --rotate-token   Reissue the API token (e.g. when the credentials file was lost)
  --acl-root       Grant the API account the whole datacenter (debugging only)
  --dry-run        Show what would be removed
  --sdn            Also remove the environment's network on reset
  --purge          Also remove guests in the environment's pools (TEARDOWN_CMD runs first)
  --keep-config    uninstall: keep the environment's settings file
  --all            uninstall: every environment, then the tool
  -y, --yes        Do not ask for confirmation

Settings: /etc/proxmox-iac-bootstrap/envs/<NAME>.env
USAGE
}

need_root() { [[ $EUID -eq 0 ]] || die "'dsoadm $1' must run as root on the Proxmox host."; }

# ---------- Global option: --env NAME (anywhere on the line) ----------
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --env)   [[ $# -ge 2 ]] || die "--env needs a name"; DSO_ENV="$2"; shift 2 ;;
    --env=*) DSO_ENV="${1#--env=}"; shift ;;
    *)       ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
export DSO_ENV="${DSO_ENV:-lab}"
env_validate "$DSO_ENV"
if [[ $EUID -eq 0 ]]; then migrate_legacy_config; fi

CMD="${1:-help}"; shift || true

# suggest_settings <env>  -> KEY=VALUE defaults for a new environment, free CTID and subnet picked
suggest_settings() {
  local env="$1" subnet
  subnet="$(free_subnet)"
  cat <<EOF
SDN_ZONE=${env}
SDN_VNET=${env}mg
SDN_SUBNET=${subnet}
SDN_GATEWAY=$(net_addr "$subnet" 1)
CT_IP=$(net_addr "$subnet" 10/)
CTID=$(free_id 200)
CT_HOSTNAME=${env}-mgmt
CT_STORAGE=local-lvm
TMPL_STORAGE=local
OP_POOLS=workloads
SSH_PUBKEY_FILE=/root/.ssh/authorized_keys
REPO_URL=
EOF
}

# ensure_env_file  -> a new environment gets a settings file with free values, so it is recorded
ensure_env_file() {
  local file="${ENVS_DIR}/${DSO_ENV}.env"
  if [[ ! -f "$file" ]]; then
    install -d -m 700 "$ENVS_DIR"
    { echo "# Environment ${DSO_ENV}, written by dsoadm on $(date -u +%Y-%m-%dT%H:%MZ)."
      echo "# All keys and defaults: ${DIR}/bootstrap.env.example"
      suggest_settings "$DSO_ENV"; } > "$file"
    chmod 600 "$file"
    log "New environment '${DSO_ENV}': wrote ${file}"
  fi
}

run_init() {
  DSO_SUMMARY_FILE="$(mktemp)"; export DSO_SUMMARY_FILE
  trap 'rm -f "$DSO_SUMMARY_FILE"' EXIT
  "${DIR}/pve-host.sh"
  local rc=0
  "${DIR}/pve-facts.sh" || rc=$?
  cat "$DSO_SUMMARY_FILE"
  exit "$rc"
}

case "$CMD" in
  init)
    need_root init
    for a in "$@"; do
      case "$a" in
        --rotate-token) export ROTATE_TOKEN=1 ;;
        --acl-root)     export ACL_SCOPE=root ;;
        *) die "Unknown option for init: $a" ;;
      esac
    done
    ensure_env_file
    run_init
    ;;
  template)
    need_root template
    [[ $# -eq 0 ]] || die "template takes no options"
    "${DIR}/pve-template.sh"
    exec "${DIR}/pve-facts.sh"
    ;;
  facts)
    need_root facts
    [[ $# -eq 0 ]] || die "facts takes no options"
    exec "${DIR}/pve-facts.sh"
    ;;
  reset)
    need_root reset
    for a in "$@"; do
      case "$a" in
        --dry-run) export DRY_RUN=1 ;;
        --sdn)     export RESET_SDN=1 ;;
        --purge)   export PURGE=1 ;;
        -y|--yes)  export FORCE=1 ;;
        *) die "Unknown option for reset: $a" ;;
      esac
    done
    exec "${DIR}/pve-reset.sh"
    ;;
  list)
    need_root list
    [[ $# -eq 0 ]] || die "list takes no options"
    mapfile -t ENVS < <(env_list)
    if [[ ${#ENVS[@]} -eq 0 ]]; then echo "No environments yet. Create one: dsoadm init --env NAME"; exit 0; fi
    printf '%-8s %-6s %-10s %-18s %-14s %s\n' ENV CTID STATUS ADDRESS NETWORK SET-UP
    for e in "${ENVS[@]}"; do
      ( DSO_ENV="$e"; CONFIG_FILE=""; unset CTID CT_IP SDN_VNET SDN_VNET_ALIAS SDN_SUBNET SDN_GATEWAY
        select_env; apply_defaults
        status=$(pct status "$CTID" 2>/dev/null | awk '{print $2}' || true); status="${status:-missing}"
        if [[ -f "$STATE_FILE" ]]; then built=yes; else built=no; fi
        printf '%-8s %-6s %-10s %-18s %-14s %s\n' "$e" "$CTID" "$status" "${CT_IP%/*}" "$SDN_VNET_ALIAS" "$built" ) || true
    done
    ;;
  config)
    need_root config
    [[ $# -eq 0 ]] || die "config takes no options"
    CONFIG_FILE=""; select_env; apply_defaults
    echo "# Environment ${ENV_NAME} — file: ${CONFIG_FILE}$([[ -f "$CONFIG_FILE" ]] || echo ' (not created yet)')"
    for k in SDN_ZONE SDN_VNET SDN_VNET_ALIAS SDN_SUBNET SDN_GATEWAY CTID CT_HOSTNAME CT_IP \
             CT_CORES CT_MEMORY CT_DISK CT_STORAGE TMPL_STORAGE TF_USER TF_ROLE POOL_PREFIX OP_POOLS \
             ACL_SCOPE PVE_TLS_INSECURE SSH_PUBKEY_FILE TEMPLATE_VMID; do
      printf '%-17s %s\n' "$k" "${!k:-(empty)}"
    done
    for k in REPO_URL REPO_LINK TEARDOWN_CMD; do printf '%-17s %s\n' "$k" "${!k:-(empty)}"; done
    ;;
  _suggest)   # used by install.sh
    need_root _suggest
    suggest_settings "$DSO_ENV"
    ;;
  uninstall)
    need_root uninstall
    KEEP_CONFIG=0; YES=0; DRY=0; ALL=0
    for a in "$@"; do
      case "$a" in
        --keep-config) KEEP_CONFIG=1 ;;
        --dry-run)     DRY=1 ;;
        --all)         ALL=1 ;;
        -y|--yes)      YES=1 ;;
        *) die "Unknown option for uninstall: $a" ;;
      esac
    done
    mapfile -t ENVS < <(env_list)
    # Where the shared LXC templates live (read now: the settings files may be removed below)
    TMPL_STORAGE="$(grep -hE '^TMPL_STORAGE=' "${ENVS_DIR}"/*.env 2>/dev/null | tail -n1 | cut -d= -f2 | sed 's/[[:space:]]*#.*//')"
    TMPL_STORAGE="${TMPL_STORAGE:-local}"
    if [[ $ALL -eq 1 ]]; then TARGETS=("${ENVS[@]+"${ENVS[@]}"}"); else TARGETS=("$DSO_ENV"); fi

    for e in "${TARGETS[@]+"${TARGETS[@]}"}"; do
      log "Environment '${e}': reset --purge --sdn"
      DSO_ENV="$e" DRY_RUN="$DRY" FORCE="$YES" PURGE=1 RESET_SDN=1 CONFIG_FILE="" "${DIR}/pve-reset.sh"
      if [[ $DRY -eq 0 && $KEEP_CONFIG -eq 0 && ! -f "${ENVS_DIR}/${e}.state" ]]; then
        rm -f "${ENVS_DIR}/${e}.env"; log "Forgot environment '${e}'"
      fi
    done

    mapfile -t LEFT < <(env_list)
    if [[ $DRY -eq 1 ]]; then
      echo -e "  \e[1;33m⚠\e[0m Dry run: nothing was removed. The tool is removed only with the last environment."
      exit 0
    fi
    if [[ ${#LEFT[@]} -gt 0 ]]; then
      log "Other environments remain (${LEFT[*]}): dsoadm and the image cache stay."
      exit 0
    fi

    # Last environment gone: remove downloaded images and the tool itself
    pveam list "$TMPL_STORAGE" 2>/dev/null | awk '{print $1}' | grep -E '/debian-[0-9]+-standard_' \
      | while read -r t; do log "Removing LXC template ${t}"; pveam remove "$t"; done || true
    for f in /var/lib/vz/template/cache/debian-12-genericcloud-amd64.qcow2 \
             /var/lib/vz/template/cache/debian-12-genericcloud-amd64.qcow2.SHA512SUMS; do
      if [[ -e "$f" ]]; then log "Removing ${f}"; rm -f "$f"; fi
    done
    if [[ $KEEP_CONFIG -eq 0 ]]; then rm -rf "$ETC_DIR"; log "Removed ${ETC_DIR}"; fi
    LIB_DIR="$(cd "${DIR}/.." && pwd)"
    if [[ "$LIB_DIR" == "$INSTALLED_LIB" ]]; then
      if [[ "$(readlink "$BIN_LINK" 2>/dev/null)" == "${INSTALLED_LIB}/"* ]]; then rm -f "$BIN_LINK"; fi
      rm -rf "$INSTALLED_LIB"   # Last: this script lives there (already loaded, so safe)
      log "Removed dsoadm. To install again, run the one-line installer."
    else
      log "dsoadm runs from ${LIB_DIR} (a source folder): left alone."
    fi
    ;;
  version|--version)
    if [[ -f "${DIR}/../VERSION" ]]; then echo "dsoadm $(cat "${DIR}/../VERSION")"; else echo "dsoadm (source checkout)"; fi
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; echo >&2; die "Unknown command: ${CMD}" ;;
esac
