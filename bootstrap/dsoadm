#!/usr/bin/env bash
# =============================================================
# dsoadm — host-side CLI for proxmox-iac-bootstrap
# Runs on the Proxmox host as root.
# Thin wrapper around the pve-*.sh scripts in the same folder.
# =============================================================
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DSO_BACKEND="${DSO_BACKEND:-proxmox}"

die() { echo -e "  \e[1;31m✖\e[0m dsoadm: $*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
dsoadm — Proxmox IaC bootstrap (host side)

Usage:
  dsoadm init     [--rotate-token] [--acl-root]   API account, network, pools, management node
  dsoadm template                                 Cloud-init VM template for OpenTofu to clone
  dsoadm facts                                    Tell the management node about this host
  dsoadm reset    [--dry-run] [--sdn] [--purge] [-y]
                                                  Undo what init and template created
  dsoadm uninstall [--keep-config] [--dry-run] [-y]
                                                  reset --purge --sdn, then remove downloaded
                                                  images and dsoadm itself
  dsoadm version                                  Show the installed version and config file

Options:
  --rotate-token   Reissue the API token (e.g. when the credentials file was lost)
  --acl-root       Grant the API account the whole datacenter (debugging only)
  --dry-run        Show what reset would remove
  --sdn            Also remove the management network on reset
  --purge          Also remove guests in the operational pools (and, with --sdn,
                   the other vnets in the zone). Runs TEARDOWN_CMD first if set.
  -y, --yes        Do not ask for confirmation
  --keep-config    uninstall: keep /etc/proxmox-iac-bootstrap

Config file (first one found):
  $CONFIG_FILE, /etc/proxmox-iac-bootstrap/bootstrap.env, <install dir>/bootstrap/bootstrap.env
USAGE
}

# First config file found wins; exported so every pve-*.sh reads the same one
if [[ -z "${CONFIG_FILE:-}" ]]; then
  for f in /etc/proxmox-iac-bootstrap/bootstrap.env "${DIR}/bootstrap.env"; do
    if [[ -f "$f" ]]; then CONFIG_FILE="$f"; break; fi
  done
fi
export CONFIG_FILE="${CONFIG_FILE:-/etc/proxmox-iac-bootstrap/bootstrap.env}"

[[ "$DSO_BACKEND" == "proxmox" ]] || die "Unsupported backend '${DSO_BACKEND}'"

# cfg <KEY> <default>  -> value from the config file (last match), else the default
cfg() {
  local v=""
  if [[ -f "$CONFIG_FILE" ]]; then
    v=$(grep -E "^[[:space:]]*$1[[:space:]]*=" "$CONFIG_FILE" | tail -n1 | cut -d= -f2- || true)
    v="${v%%#*}"; v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
  fi
  echo "${v:-$2}"
}

need_root() { [[ $EUID -eq 0 ]] || die "'dsoadm $1' must run as root on the Proxmox host."; }

CMD="${1:-help}"; shift || true
case "$CMD" in
  init)
    need_root init
    for a in "$@"; do
      case "$a" in
        --rotate-token) export ROTATE_TOKEN=1 ;;
        --acl-root)     export ACL_SCOPE=root ;;
        *) die "Unknown option for init: $a" ;;
      esac
    done
    DSO_SUMMARY_FILE="$(mktemp)"; export DSO_SUMMARY_FILE
    trap 'rm -f "$DSO_SUMMARY_FILE"' EXIT
    "${DIR}/pve-host.sh"
    rc=0
    "${DIR}/pve-facts.sh" || rc=$?
    cat "$DSO_SUMMARY_FILE"
    exit "$rc"
    ;;
  template)
    need_root template
    [[ $# -eq 0 ]] || die "template takes no options"
    "${DIR}/pve-template.sh"
    exec "${DIR}/pve-facts.sh"
    ;;
  facts)
    need_root facts
    [[ $# -eq 0 ]] || die "facts takes no options"
    exec "${DIR}/pve-facts.sh"
    ;;
  reset)
    need_root reset
    for a in "$@"; do
      case "$a" in
        --dry-run) export DRY_RUN=1 ;;
        --sdn)     export RESET_SDN=1 ;;
        --purge)   export PURGE=1 ;;
        -y|--yes)  export FORCE=1 ;;
        *) die "Unknown option for reset: $a" ;;
      esac
    done
    exec "${DIR}/pve-reset.sh"
    ;;
  uninstall)
    need_root uninstall
    KEEP_CONFIG=0; YES=0; DRY=0
    for a in "$@"; do
      case "$a" in
        --keep-config) KEEP_CONFIG=1 ;;
        --dry-run)     DRY=1 ;;
        -y|--yes)      YES=1 ;;
        *) die "Unknown option for uninstall: $a" ;;
      esac
    done
    INSTALLED_LIB=/usr/local/lib/proxmox-iac-bootstrap
    BIN_LINK=/usr/local/sbin/dsoadm
    ETC_DIR=/etc/proxmox-iac-bootstrap
    LIB_DIR="$(cd "${DIR}/.." && pwd)"
    TMPL_STORAGE="$(cfg TMPL_STORAGE local)"
    DEBIAN_VERSION="$(cfg DEBIAN_VERSION 12)"
    IMAGE_DIR="$(cfg IMAGE_DIR /var/lib/vz/template/cache)"
    IMAGE_FILE="$(cfg IMAGE_FILE debian-12-genericcloud-amd64.qcow2)"
    mapfile -t LXC_TEMPLATES < <(pveam list "$TMPL_STORAGE" 2>/dev/null | awk '{print $1}' \
      | grep -E "/debian-${DEBIAN_VERSION}-standard_" || true)

    echo
    echo "After the reset below, uninstall also removes:"
    for t in "${LXC_TEMPLATES[@]}"; do echo "  - LXC template ${t}"; done
    for f in "${IMAGE_DIR}/${IMAGE_FILE}" "${IMAGE_DIR}/${IMAGE_FILE}.SHA512SUMS"; do
      if [[ -e "$f" ]]; then echo "  - ${f}"; fi
    done
    if [[ "$LIB_DIR" == "$INSTALLED_LIB" ]]; then
      echo "  - ${INSTALLED_LIB} and ${BIN_LINK}"
    else
      echo "  - (dsoadm runs from ${LIB_DIR}, a source folder: left alone)"
    fi
    if [[ $KEEP_CONFIG -eq 0 ]]; then echo "  - ${ETC_DIR}"; fi

    # Reset asks for confirmation (unless -y) and stops on any problem
    DRY_RUN="$DRY" FORCE="$YES" PURGE=1 RESET_SDN=1 "${DIR}/pve-reset.sh"

    run() { if [[ $DRY -eq 1 ]]; then echo -e "\e[1;36m[dry-run]\e[0m $*"; else "$@"; fi; }
    for t in "${LXC_TEMPLATES[@]}"; do run pveam remove "$t"; done
    run rm -f "${IMAGE_DIR}/${IMAGE_FILE}" "${IMAGE_DIR}/${IMAGE_FILE}.SHA512SUMS"
    if [[ $KEEP_CONFIG -eq 0 ]]; then run rm -rf "$ETC_DIR"; fi
    if [[ "$LIB_DIR" == "$INSTALLED_LIB" ]]; then
      if [[ "$(readlink "$BIN_LINK" 2>/dev/null)" == "${INSTALLED_LIB}/"* ]]; then run rm -f "$BIN_LINK"; fi
      run rm -rf "$INSTALLED_LIB"   # Last: this script lives there (already loaded, so safe)
    fi
    if [[ $DRY -eq 1 ]]; then
      echo -e "  \e[1;33m⚠\e[0m Dry run: nothing was removed."
    else
      echo -e "  \e[1;32m✔\e[0m Uninstalled. To install again, run the one-line installer."
    fi
    ;;
  version|--version)
    if [[ -f "${DIR}/../VERSION" ]]; then
      echo "dsoadm $(cat "${DIR}/../VERSION")"
    else
      echo "dsoadm (source checkout, no VERSION file)"
    fi
    if [[ -f "$CONFIG_FILE" ]]; then echo "config: ${CONFIG_FILE}"; else echo "config: none (defaults)"; fi
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; echo >&2; die "Unknown command: ${CMD}" ;;
esac
