# proxmox-iac-bootstrap settings
#
# install.sh writes /etc/proxmox-iac-bootstrap/bootstrap.env for you.
# Copy any line from here into that file to change it.
# Format: KEY=VALUE, one per line. The file is read, never executed.
# Every value below is the default used when the key is missing.

# ---- Naming ----
PROJECT_ID=lab                 # Pool marker, credentials path (/root/.config/<id>/), clone dir (~/<id>)

# ---- Management network (Proxmox SDN) ----
SDN_ZONE=lab                   # Simple zone
SDN_VNET=lmgmt                 # 8 characters max
SDN_SUBNET=10.73.10.0/24
SDN_GATEWAY=10.73.10.1         # The host's address on that subnet; SNAT is turned on

# ---- Management LXC ----
CTID=200
CT_HOSTNAME=iac-mgmt
CT_IP=10.73.10.10/24           # or dhcp
# CT_GW=                       # defaults to SDN_GATEWAY
CT_CORES=1
CT_MEMORY=1024                 # MiB
CT_SWAP=512                    # MiB
CT_DISK=10                     # GiB
CT_STORAGE=local-lvm
TMPL_STORAGE=local
DEBIAN_VERSION=12
SSH_PUBKEY_FILE=/root/.ssh/authorized_keys   # Keys merged into the LXC; empty = none

# ---- API account for OpenTofu ----
TF_USER=terraform@pve
TF_ROLE=TerraformRole
TF_SDN_ROLE=TerraformSDNApply
TF_TOKEN_ID=provider
PVE_TLS_INSECURE=1             # 1 = do not check the API certificate (PVE's own cert is self-signed)

# ---- Pools and permissions ----
POOL_PREFIX=lab                # Pools: <prefix>-mgmt and <prefix>-<each OP_POOLS entry>
OP_POOLS=tools k8s targets     # Pools OpenTofu may fill; the API account gets access to these only
ACL_SCOPE=narrow               # narrow | root (root = whole datacenter, debugging only)
ALLOW_EXISTING_POOL=0          # 1 = reuse a pool this project did not create
# NODE_NAME=                   # defaults to $(hostname)

# ---- Inside the management LXC ----
RUN_MGMT_SETUP=1               # 0 = create the LXC but do not install OpenTofu/Ansible
REPO_URL=                      # Git repository to clone into ~/<PROJECT_ID>
REPO_LINK=                     # Executable in that repository to link into /usr/local/bin

# ---- Cosmetic ----
SET_TAG_COLORS=0               # 1 = set tag colors cluster-wide (replaces the existing color map)
