# proxmox-iac-bootstrap settings for ONE environment
#
# File: /etc/proxmox-iac-bootstrap/envs/<env>.env   (install.sh or `dsoadm init` writes it)
# Format: KEY=VALUE, one per line. The file is read, never executed.
# A key left out uses the default shown here. <env> is the environment name.
# See what an environment will actually use: dsoadm config --env <env>

# ---- Management network (Proxmox SDN) ----
# SDN_ZONE=<env>                 # Simple zone, 8 characters max
# SDN_VNET=<env>mg               # VNet ID: 8 characters max, letters and digits, unique on the cluster
# SDN_VNET_ALIAS=<env>-mgmt      # Name shown in the Proxmox UI
# SDN_SUBNET=10.73.10.0/24       # A new environment gets the next free 10.N.10.0/24
# SDN_GATEWAY=                 # defaults to host 1 of the subnet (10.73.10.1); SNAT is turned on

# ---- Management LXC ----
# CTID=200                       # A new environment gets the first free ID from 200
# CT_HOSTNAME=<env>-mgmt
# CT_IP=                       # defaults to host 10 of the subnet (10.73.10.10/24); or dhcp
# CT_GW=                       # defaults to SDN_GATEWAY
CT_CORES=1
CT_MEMORY=1024                 # MiB
CT_SWAP=512                    # MiB
CT_DISK=10                     # GiB
CT_STORAGE=local-lvm
TMPL_STORAGE=local
DEBIAN_VERSION=12
SSH_PUBKEY_FILE=/root/.ssh/authorized_keys   # Keys merged into the LXC; empty = none

# ---- API account for OpenTofu ----
# TF_USER=iac-<env>@pve
# TF_ROLE=IaC-<env>            # also IaC-<env>-SDN and (with a VM template) IaC-<env>-Clone
TF_TOKEN_ID=provider
PVE_TLS_INSECURE=1             # 1 = do not check the API certificate (PVE's own cert is self-signed)

# ---- Pools and permissions ----
# POOL_PREFIX=<env>            # Pools: <prefix>-mgmt, <prefix>-<each OP_POOLS entry>, <prefix>-templates
OP_POOLS=workloads             # Pools OpenTofu may fill, space-separated (e.g. "tools k8s");
                               # the API account gets access to these only
ACL_SCOPE=narrow               # narrow | root (root = whole datacenter, debugging only)
ALLOW_EXISTING_POOL=0          # 1 = reuse a pool this environment did not create

# ---- VM template (optional, `dsoadm template`) ----
# TEMPLATE_VMID=               # first free ID from 9000, picked and saved on first run
TEMPLATE_NAME=debian-12-cloud

# ---- Inside the management LXC ----
RUN_MGMT_SETUP=1               # 0 = create the LXC but do not install OpenTofu/Ansible
REPO_URL=                      # Git repository to clone into ~/<env>
REPO_LINK=                     # Executable in that repository to link into /usr/local/bin

# ---- Reset ----
TEARDOWN_CMD=                  # Run inside the management LXC by `dsoadm reset --purge` before
                               # anything is removed, e.g. "dsoctl down --all". Empty = none.

# ---- Cosmetic ----
SET_TAG_COLORS=0               # 1 = set tag colors cluster-wide (replaces the existing color map)
